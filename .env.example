# Example environment variables for this project
# Copy this file to `.env` (do NOT commit your real `.env`) and fill the values.

# MongoDB connection string (replace placeholders)
MONGO_DB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority

# JSON Web Token secret (generate a strong random value and keep it secret)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# Node environment
NODE_ENV=development

# Port (Render provides PORT automatically; you can leave this blank locally)
PORT=5000

# Notes:
# - Do NOT commit a real `.env` file with secrets to source control.
# - Generate a secure `JWT_SECRET` locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - On Render: add `MONGO_DB_URI`, `JWT_SECRET`, and `NODE_ENV` as Environment Variables in the service settings.
